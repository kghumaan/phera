# Reject iCloud / macOS sync-conflict duplicates ("foo 2.tsx", "bar copy.ts").
# These are NEVER source-of-truth — they're stale snapshots iCloud Drive
# preserves when it detects divergent local + cloud copies.
DUPES=$(git diff --cached --name-only --diff-filter=AM | grep -E ' [2-9]\.[A-Za-z0-9]+$| [1-9][0-9]+\.[A-Za-z0-9]+$| copy\.[A-Za-z0-9]+$| conflicted ' || true)
if [ -n "$DUPES" ]; then
  echo ""
  echo "❌ Refusing to commit iCloud/macOS sync-conflict duplicates:"
  echo "$DUPES" | sed 's/^/    /'
  echo ""
  echo "These are auto-generated by iCloud Drive Desktop sync. Diff each against"
  echo "its non-suffixed sibling, keep the correct content in the original, and"
  echo "delete the duplicate. See seo-audit/AUDIT.md and CLAUDE.md for the rule."
  echo ""
  exit 1
fi

npx lint-staged
