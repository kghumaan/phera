# ───────────────────────────────────────────────────────────────────
# Phera environment — copy to .env.local and fill in the blanks.
# Every var here is READ somewhere in the app. Unset = silent failure.
# Same file covers local dev and Vercel project env.
# ───────────────────────────────────────────────────────────────────

# ─── Supabase (Postgres + Auth + Realtime) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-side only. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Test Supabase project (integration tests only, free-tier clone).
# Leave blank in prod.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# ─── App URL ───────────────────────────────────────────────────────
# Used in OAuth redirects, WhatsApp deep links, email templates.
# Local: http://localhost:3000  —  Prod: https://phera.io
NEXT_PUBLIC_APP_URL=https://phera.io

# ─── WhatsApp via Whapi.Cloud (both guest + vendor sides) ──────────
# Single phone number / Whapi channel handles everything.
# Phera does not use Meta Business Cloud API templates anymore.
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_API_TOKEN=
# Shared secret for Whapi -> our webhook. Generate a long random string.
WHAPI_WEBHOOK_SECRET=
# Display number shown in admin UI ("Add this to your group chat").
# +12135551234 style.
PHERA_PHONE_NUMBER=

# Meta WhatsApp vars are LEGACY — only still set if a wedding is
# grandfathered onto the Cloud API. Safe to leave blank for new deploys.
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# Vendor-coordinator webhook shared secret (Whapi -> vendors webhook).
# Recommended but optional.
VENDOR_WEBHOOK_SECRET=

# ─── AI providers ──────────────────────────────────────────────────
# Groq: Whisper transcription + Llama 3.3 70B for concierge replies.
GROQ_API_KEY=
# Gemini: build-ai flow image generation.
GEMINI_API_KEY=
# Giphy: GIF picker for guest RSVP comment step.
GIPHY_API_KEY=

# ─── Stripe (multi-currency: USD + INR) ────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
# Registered in Stripe dashboard -> Developers -> Webhooks.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=
# The From address on invite + alert emails. Must be a verified sender.
RESEND_FROM_EMAIL=hello@phera.io

# ─── Cron secret ───────────────────────────────────────────────────
# Vercel Cron calls /api/cron/outreach with this as a bearer token.
# Must match the value set in Vercel project env.
CRON_SECRET=

# ─── Demo + template seeding (dev helpers) ─────────────────────────
TEMPLATE_WEDDING_SLUG=simran-karanvir
SEED_DEMO_TEMPLATE_SECRET=

# ─── Sentry (error + perf monitoring) ──────────────────────────────
# See sentry.*.config.ts — these are READ by withSentryConfig.
# Usually set by running `npx @sentry/wizard` once.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Phera Agent (admin planner assistant)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-8
AGENT_MODEL=
# Agent Lab (disposable agent test weddings; lab routes 404 unless set)
AGENT_LAB_TOKEN=
# Owner for token-seeded lab weddings (so they appear in your admin)
AGENT_LAB_OWNER_EMAIL=

# Agent voice output (Groq PlayAI TTS)
AGENT_TTS_VOICE=tara
# Orpheus needs one-time terms acceptance in the Groq console
# AGENT_TTS_MODEL=canopylabs/orpheus-v1-english
