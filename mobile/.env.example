# Phera mobile — NO .env IS NEEDED. The app ships with production defaults
# baked into src/lib/config.ts (Supabase URL + public anon key, API base
# https://www.phera.io) and connects to the real backend out of the box.
# Copy this file to .env only to OVERRIDE those defaults.

# Force preview mode: mock fixtures, no network, any email signs in.
# EXPO_PUBLIC_PREVIEW=1

# Point at a different Supabase project (values match the web
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY).
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL for server-side API routes (agent chat, guest access).
# Use http://localhost:3000 when running `next dev` alongside.
# EXPO_PUBLIC_API_BASE_URL=
